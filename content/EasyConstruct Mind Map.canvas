 "nodes": [
  {
   "id": "center",
   "type": "text",
   "text": "# 🏗️ EasyConstruct\n[[00 Start Here|Open Start Here]]\n\nCloud-based construction operations management system for ORRA Construction Inc.",
   "x": -200,
   "y": -110,
   "width": 400,
   "height": 220,
   "color": "4"
  },
  {
   "id": "L0",
   "type": "text",
   "text": "## Big Picture",
   "x": -860,
   "y": -1315,
   "width": 260,
   "height": 80,
   "color": "1"
  },
  {
   "id": "L0_0",
   "type": "text",
   "text": "**[[What is EasyConstruct]]**\nPERN web app for ORRA",
   "x": -1300,
   "y": -1495,
   "width": 300,
   "height": 90,
   "color": "1"
  },
  {
   "id": "L0_1",
   "type": "text",
   "text": "**[[The Problem at ORRA]]**\nExcel, folders, manual pay",
